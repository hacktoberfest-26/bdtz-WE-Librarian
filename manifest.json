{
  "manifest_version": 3,
  "name": "WE Librarian",
  "version": "0.1.0",
  "description": "Librarian Input di H-OS: raccoglie, con il tuo consenso esplicito, contesto da Meet, ricerche e download per il Company Brain.",
  "permissions": ["downloads", "storage", "activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://meet.google.com/*",
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "WE Librarian",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/meet_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*"
      ],
      "js": ["content/search_script.js"],
      "run_at": "document_idle"
    }
  ]
}
